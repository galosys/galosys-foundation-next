<galosys:ChromeWindow x:Class="MafSample.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MafSample.WpfApp"
        xmlns:galosys="https://galosys.com/wpf"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="960" 
        Width="1280"
        WindowStartupLocation="CenterScreen">
    <galosys:ChromeWindow.TitleContent>
        <TextBlock Text="G" FontSize="20" FontWeight="{DynamicResource FontWeightSemibold}"
                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
    </galosys:ChromeWindow.TitleContent>
    <galosys:ChromeWindow.Resources>
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Indicator" RadiusX="1.5" RadiusY="1.5"
                                           Fill="Transparent" VerticalAlignment="Stretch"
                                           Margin="0,2" />
                                <ContentPresenter x:Name="Content" Grid.Column="1"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="13" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Surface1Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Indicator" Property="Fill"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Content" Property="TextElement.FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </galosys:ChromeWindow.Resources>
    <galosys:NavMenu></galosys:NavMenu>
    <!--<galosys:ProDataGrid x:Name="DemoGrid"
                     AutoGenerateColumns="True"
                     ShowSearch="True"
                     ShowToolbar="True"
                     ShowPagination="True"
                     PageSize="20" />-->
</galosys:ChromeWindow>
