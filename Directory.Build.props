<Project>
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<RootNamespace/>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Authors>Galosys</Authors>
		<Description>Galosys.Foundation 原型试验场</Description>
		<Copyright>版权所有 (c) Galosys.Foundation 2024</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<InvariantGlobalization>false</InvariantGlobalization>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		
		<ImplicitUsings>enable</ImplicitUsings>

		<!--中央包版本-->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!--中央包版本-->

		<!--关闭 TreatWarningsAsErrors galoS@2026-04-22-->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<NoWarn Condition="'$(Configuration)' == 'Release'">$(NoWarn);CA1416;CA2017;CS0108;CS0168;CS0169;CS0414;CS0436;CS0472;CS0612;CS0618;CS0628;CS0649;CS0693;CS1570;CS1572;CS1573;CS1587;CS1591;CS1711;CS8609;CS8597;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8621;CS8622;CS8625;CS8634;CS8714;CS8765;CS8766;CS8767;CS9057;MVVMTK0034;RS1024;SYSLIB0050;xUnit2009;ASP0029</NoWarn>
		<!-- Microsoft.Extensions.Validation 预览 API：所有配置（含 Debug）抑制 ASP0029 galoS@2026-09-04 -->
		<NoWarn>$(NoWarn);ASP0029</NoWarn>

		<!--NetAnalyzers 使用 SDK 内置分析器 galoS@2026-04-11 17:30:00-->
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Default</AnalysisMode>
		<_SkipUpgradeNetAnalyzersNuGetWarning>true</_SkipUpgradeNetAnalyzersNuGetWarning>
	</PropertyGroup>

	<!--<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
	</ItemGroup>-->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
	</ItemGroup>
</Project>